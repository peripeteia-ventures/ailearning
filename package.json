{
  "name": "latent-ai-fieldnotes", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "db:setup": "node server/setup.ts",
