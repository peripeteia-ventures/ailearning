# Copy to .env; chmod 600 .env. Never commit .env or share rendered compose output.
# Deliberately invalid until operator selects/tests a digest for their GPU/driver.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:REPLACE_WITH_TESTED_DIGEST
MODEL_DIR=/srv/ai-farm/models
MODEL_FILE=qwen2.5-7b-instruct-q3_k_m.gguf
MODEL_REVISION=bb5d59e06d9551d752d08b292a50eb208b07ab1f
MODEL_SHA256=a96b16179dc6cc9afdf0cf7a96a80c199cbd00b9be207c3465be21cb721cca5e
# Host A; use 10.20.0.12 on host B. Replace with addresses assigned to your LAN.
INFERENCE_BIND_IP=10.20.0.11
INFERENCE_A_URL=http://10.20.0.11:8080
INFERENCE_B_URL=http://10.20.0.12:8080
INFERENCE_API_KEY=REPLACE_WITH_RANDOM_HEX
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_PORT=8088
APP_ORIGIN=http://localhost:8088
COOKIE_SECURE=false
# Pin these image tags to tested digests for repeatable operation too.
POSTGRES_IMAGE=postgres:18
NGINX_IMAGE=nginx:stable-alpine
ALLOW_CLOUD=false
OPENAI_API_KEY=
OPENAI_MODEL=
